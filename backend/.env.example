# Copy this file to .env and fill in the keys you have. Any AI seat whose key
# is missing falls back to a randomized mock player, so the app runs fine with
# none, some, or all of these set.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Optional overrides -- defaults are set in app/config.py
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5.1
# DEEPSEEK_MODEL=deepseek-v4-pro
# GEMINI_MODEL=gemini-3-pro
# XAI_MODEL=grok-5

# AI_THINKING_DELAY_SECONDS=1.2
# FRONTEND_ORIGIN=http://localhost:5173
